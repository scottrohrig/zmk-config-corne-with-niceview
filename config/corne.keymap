#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE_HELPER 4
#define MOUSE_LAYER 5

/ {
    combos {
        compatible = "zmk,combos";

        sys_reset_l {
            bindings = <&sys_reset>;
            key-positions = <1 12 24 5>;
            layers = <1>;
        };

        to_layer_3 {
            bindings = <&sl 3>;
            key-positions = <2 3>;
            layers = <1>;
        };

        mouse_toggle {
            bindings = <&tog MOUSE_LAYER>;
            key-positions = <6 10>; // Y + P
            layers = <MOUSE_HELPER MOUSE_LAYER>;
            timeout-ms = <50>;
        };

        combo_bt_next {
            bindings = <&bt BT_NXT>;
            key-positions = <0 5>;
            layers = <1>;
        };
    };

    macros {
        right_alt_mouse_helper: right_alt_mouse_helper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            bindings = <&macro_press &mo MOUSE_HELPER &kp RALT>,
                       <&macro_pause_for_release>,
                       <&macro_release &kp RALT &mo MOUSE_HELPER>;
        };
    };

    behaviors {
        hrm: hrm {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <275>;
            flavor = "balanced";
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            require-prior-idle-ms = <140>;
            tapping-term-ms = <250>;
            quick-tap-ms = <275>;
            hold-trigger-key-positions = <19 20 21 22 30 18 6 7 8 9 10 11 23 35 34 33 31 32 41 40 39>;
            flavor = "balanced";
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            require-prior-idle-ms = <140>;
            tapping-term-ms = <250>;
            quick-tap-ms = <275>;
            flavor = "balanced";
            hold-trigger-key-positions = <38 37 36 29 28 27 26 25 24 12 0 1 13 14 2 3 15 16 4 5 17>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&mt LEFT_ALT TAB  &kp Q                &kp W            &kp E         &kp R              &kp T                   &kp Y    &kp U               &kp I         &kp O        &kp P                    &kp BSPC
&mt LCTRL ESC     &hml LEFT_COMMAND A  &hml LEFT_ALT S  &hml LCTRL D  &hml LEFT_SHIFT F  &kp G                   &kp H    &hrm RIGHT_SHIFT J  &hrm RCTRL K  &hmr RALT L  &hmr RIGHT_COMMAND SEMI  &kp SQT
&kp LSHFT         &kp Z                &kp X            &kp C         &kp V              &kp B                   &kp N    &kp M               &kp COMMA     &kp DOT      &kp FSLH                 &kp RIGHT_SHIFT
                                                        &kp LGUI      &mo 1              &mt LEFT_SHIFT SPACE    &kp RET  &mo 2               &right_alt_mouse_helper
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB          &kp N1  &kp N2  &kp N3    &kp N4  &kp N5       &kp N6    &kp N7    &kp N8    &kp N9     &kp N0  &kp BSPC
&mt CAPS ESCAPE  &trans  &trans  &trans    &trans  &trans       &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT  &trans  &trans
&kp LSHFT        &trans  &trans  &trans    &trans  &trans       &trans    &trans    &trans    &trans     &trans  &trans
                                 &kp LGUI  &trans  &kp SPACE    &kp RET   &trans    &kp RALT
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB    &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS   &kp KP_MULTIPLY  &kp LPAR  &kp RPAR  &kp BSPC
&kp LCTRL  &trans    &trans  &trans    &trans    &trans       &kp MINUS  &kp EQUAL  &kp LBKT         &kp RBKT  &kp BSLH  &kp GRAVE
&kp LSHFT  &trans    &trans  &trans    &trans    &trans       &kp UNDER  &kp PLUS   &kp LBRC         &kp RBRC  &kp PIPE  &kp TILDE
                             &kp LGUI  &trans    &kp SPACE    &kp RET    &trans     &kp RALT
            >;
        };

        fn {
            bindings = <
&bt BT_CLR  &kp F1        &kp F2        &kp F3        &kp F4        &kp F5    &kp F6      &kp F7            &kp F8      &kp F9      &kp F10            &trans
&bt BT_NXT  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans    &kp K_PREV  &kp K_PLAY_PAUSE  &kp K_NEXT  &kp K_MUTE  &kp K_VOLUME_DOWN  &kp C_VOLUME_UP
&trans      &trans        &trans        &trans        &trans        &trans    &trans      &trans            &trans      &trans      &trans             &trans
                                        &trans        &trans        &trans    &trans      &trans            &trans
            >;
        };

        // Active only while right Alt is held; transparent bindings retain all keys.
        mouse_helper {
            bindings = <
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                     &trans &trans &trans    &trans &trans &trans
            >;
        };

        mouse {
            bindings = <
&trans &trans &msc SCRL_UP &mmv MOVE_UP &msc SCRL_DOWN &trans    &trans &msc SCRL_UP &mmv MOVE_UP &msc SCRL_DOWN &trans &trans
&trans &trans &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &trans    &trans &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &trans &trans
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                           &mkp MCLK &mkp RCLK &mkp LCLK    &mkp LCLK &mkp RCLK &mkp MCLK
            >;
        };
    };
};
